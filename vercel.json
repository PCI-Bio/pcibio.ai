{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/education/p53-classification",
      "destination": "/learn-p53",
      "permanent": true
    },
    {
      "source": "/education/mmr-assessment",
      "destination": "/learn-mmr",
      "permanent": true
    },
    {
      "source": "/education/antibody-optimization",
      "destination": "/learn-controls",
      "permanent": true
    },
    {
      "source": "/education/ai-biomarker-assessment",
      "destination": "/learn-ai",
      "permanent": true
    },
    {
      "source": "/education/foundations/:slug",
      "destination": "/education#foundations",
      "permanent": true
    },
    {
      "source": "/education/cases/:slug",
      "destination": "/education",
      "permanent": false
    },
    {
      "source": "/research/p53-cell-line-panel",
      "destination": "/education#modules",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "/education#modules",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/pilot",
      "permanent": false
    },
    {
      "source": "/register",
      "destination": "/pilot",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sample-report/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
